
name: Build ZXPlay Emulator

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Get repository
        uses: actions/checkout@v4

      - name: Extract ZXPlay source
        run: |
          ZIP=$(find . -maxdepth 1 -name "*.zip" | head -n 1)
          if [ -z "$ZIP" ]; then
            echo "ZXPlay ZIP not found"
            exit 1
          fi
          unzip -q "$ZIP" -d /tmp/zxplay
          cp -R /tmp/zxplay/zxplay-main/. .

      - name: Install Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Build emulator
        run: npm run build

      - name: Prepare website
        run: |
          sed -i 's|href="/|href="./|g; s|src="/|src="./|g' public/index.html
          mkdir -p public/dist
          touch public/.nojekyll

      - name: Upload website
        uses: actions/upload-pages-artifact@v3
        with:
          path: public

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
    steps:
      - name: Publish ZXPlay
        uses: actions/deploy-pages@v4
